#!/usr/bin/env bash
# Installs Nginx with a 301 redirect on /redirect_me and a custom 404 page
sudo apt-get update -y
sudo apt-get install -y nginx
echo "Hello World!" | sudo tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | sudo tee /var/www/html/404.html > /dev/null
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
    sudo sed -i "/server_name _;/a location /redirect_me {\n return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n }" /etc/nginx/sites-available/default
fi
if ! grep -q "404.html" /etc/nginx/sites-available/default; then
    sudo sed -i "/server_name _;/a error_page 404 /404.html;\n location = /404.html {\n root /var/www/html;\n internal;\n }" /etc/nginx/sites-available/default
fi
sudo service nginx restart
